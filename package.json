{
  "name": "storybook-addon-sdc",
  "version": "0.26.0",
  "description": "Drupal Single Directory Components as stories",
  "keywords": [
    "SDC",
    "storybook",
    "Drupal",
    "storybook-addon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberdinsky-skilld/sdc-addon.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Ivan Berdinsky <iberdinsky@skilld.cloud>",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./preset": "./dist/preset.js",
    "./renderer/twing": "./dist/renderer/twing.js",
    "./renderer/twig": "./dist/renderer/twig.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "lint": "eslint",
    "build": "tsup",
    "build:watch": "npm run build -- --watch",
    "test": "vitest",
    "start": "run-p build:watch \"storybook --quiet\"",
    "prerelease": "zx scripts/prepublish-checks.js",
    "release": "npm run build && auto shipit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve": "npx http-server ./storybook-static",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/twig": "^1.12.17",
    "json-schema-faker": "^0.6.4",
    "jsonschema": "^1.5.0",
    "vite-plugin-twig-drupal": "^1.7.0",
    "vite-plugin-twing-drupal": "^1.1.4",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@storybook/html-vite": "^10.4.6 || ^11.0.0-beta.0",
    "drupal-attribute": "^1.2.1",
    "storybook": "^10.4.6 || ^11.0.0-beta.0",
    "twing": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^11.0.0-beta.1",
    "@storybook/addon-docs": "^11.0.0-beta.1",
    "@storybook/html-vite": "^11.0.0-beta.1",
    "@types/node": "^25.9.9",
    "auto": "^11.3.6",
    "boxen": "^9.0.0",
    "dedent": "^1.7.2",
    "drupal-attribute": "^1.2.1",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^11.0.0-beta.1",
    "tsup": "^9.0.0",
    "twing": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "zx": "^8.8.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Storybook Addon SDC",
    "supportedFrameworks": [
      "html"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  }
}
